[Unit]
Description=Kitchen audio-button orchestrator
After=sound.target network-online.target zpl-agent.service
Wants=network-online.target zpl-agent.service

[Service]
Type=simple
User=@USER@
Group=kuche-audio
SupplementaryGroups=input audio
RuntimeDirectory=kuche-pi-audio
RuntimeDirectoryMode=0755
StateDirectory=kuche-pi-audio
StateDirectoryMode=0750
ExecStartPre=-/usr/local/lib/kuche-pi-audio/print-ente-label.py --printer ente --cache-only
ExecStart=/usr/local/lib/kuche-pi-audio/audio-buttons-daemon.py --config /etc/kuche-pi-audio/config.json
Restart=always
RestartSec=2
# The daemon has only two exact NOPASSWD systemctl commands in sudoers. Do not
# set NoNewPrivileges here: it would make those deliberately scoped commands
# fail before sudo can evaluate the allowlist.
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
